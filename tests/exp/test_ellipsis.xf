    fn deep5() { ... }
    fn deep6() { ... }
    fn deep7() { ... }
    fn deep8() { ... }
    fn deep9() { ... }
    fn deep10() { ... }

    fn boomFn() {
        boom
    }

    fn bsodFn() {
        bsod
    }

    fn hangFn() {
        string s = input()
    }
}