#test {
    fn main() {
        print("start")
        sayHi()
        show(5)
        stamp("abc")
        combine(10, 20)
        greet("hello")
        ...
        for i in [1...5] {
            print(i)
        }
        ...
        print("end")
    }

    fn sayHi() {
        print("HI!")
    }

    fn greet(word) {
        print("HELLO:" + word)
    }

    fn combine(a, b) {
        print("SUM")
        print(a + b)
    }

    fn show(x) {
        print(x)
    }

    fn stamp(word) {
        print(word + "!")
    }

    fn recurse() {
        print("R")
        ...
    }

    fn deep1() { ... }
